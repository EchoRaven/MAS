,"iterate":{"max_rounds":4,"until":"output.done","feed":"output"}}},{"id":"dispatch","position":{"x":0,"y":0},"parent":"exchange","data":{"kind":"function","name":"Send each agent its view","fn":{"lang":"js","code":"const AGENTS = [\"a\",\"b\",\"c\"];\nif (input && typeof input === \"object\" && input.views) return Object.fromEntries(AGENTS.map((a) => [a, input.views[a]]));\nconst question = String(input?.text ?? input);\nctx.vars.question = question;\nctx.vars.history = { a: [], b: [], c: [] };\nreturn Object.fromEntries(AGENTS.map((a) => [a, question]));"},"join":"any","interface":{"inputs":[{"id":"in","type":"message"}],"outputs":[{"id":"a","type":"text"},{"id":"b","type":"text"},{"id":"c","type":"text"}]}}},{"id":"exchange_fn","position":{"x":680,"y":0},"parent":"exchange","data":{"kind":"function","name":"Exchange by paradigm","fn":{"lang":"js","code":"const SEES = {\"memory\":{\"a\":[\"b\",\"c\"],\"b\":[\"a\",\"c\"],\"c\":[\"a\",\"b\"]},\"report\":{\"a\":[\"b\",\"c\"],\"b\":[\"a\"],\"c\":[\"a\"]},\"relay\":{\"a\":[\"c\"],\"b\":[\"a\"],\"c\":[\"b\"]},\"debate\":{\"a\":[\"b\",\"c\"],\"b\":[\"c\"],\"c\":[\"b\"]}};\nconst NAMES = { a: \"Agent A\", b: \"Agent B\", c: \"Agent C\" };\nconst paradigm = SEES[ctx.vars.paradigm] ? ctx.vars.paradigm : \"memory\";\nconst norm = (s) => String(s).toLowerCase().replace(/(\\d),(?=\\d{3})/g, \"$1\").replace(/[^a-z0-9./-]+/g, \" \").trim().replace(/\\.+$/, \"\");\nconst finalOf = (t) => ((String(t).match(/Final:\\s*(.+)/) ?? [])[1] ?? \"\").replace(/\\*+/g, \"\").trim();\nconst h = ctx.vars.history;\nconst now = {};\nfor (const a of Object.keys(input)) {\n  now[a] = { text: String(input[a]), answer: finalOf(input[a]) };\n  h[a].push(norm(now[a].answer));\n}\n// confidence: how often an agent's answer has matched its latest one (the paper's confidence evaluation)\nconst conf = (a) => h[a].filter((x) => x === h[a][h[a].length - 1]).length / h[a].length;\nconst round = h.a.length;\nconst answers = Object.keys(now).map((a) => norm(now[a].answer));\nconst agreed = answers.every((x) => x && x === answers[0]);\nif (agreed) return { role: \"assistant\", text: \"Paradigm: \" + paradigm + \". All three agree after round \" + round + \".\\nFinal: \" + now.a.answer, done: true };\nconst views = {};\nfor (const a of Object.keys(now)) {\n  const seen = SEES[paradigm][a].map((o) => \"## \" + NAMES[o] + \" (confidence \" + conf(o).toFixed(2) + \")\\n\" + now[o].text).join(\"\\n\\n\");\n  views[a] = ctx.vars.question + \"\\n\\nYour previous answer:\\n\" + now[a].text + \"\\n\\nWhat you can see of the others this round:\\n\" + seen;\n}\n// if the rounds run out, the answer is the vote weighted by confidence\nconst score = {};\nconst shown = {};\nfor (const a of Object.keys(now)) if (now[a].answer) { const k = norm(now[a].answer); score[k] = (score[k] ?? 0) + conf(a); shown[k] ??= now[a].answer; }\nconst best = Object.entries(score).sort((x, y) => y[1] - x[1])[0];\nreturn { role: \"assistant\", text: \"Paradigm: \" + paradigm + \". No agreement after round \" + round + \"; vote weighted by confidence.\\nFinal: \" + (best ? shown[best[0]] : \"none\"), views, done: false };"},"join":"all","interface":{"inputs":[{"id":"a","type":"text","required":true},{"id":"b","type":"text","required":true},{"id":"c","type":"text","required":true}],"outputs":[{"id":"out","type":"message"}]}}},{"id":"a","position":{"x":340,"y":-150},"parent":"exchange","data":{"kind":"agent","name":"Agent A","role":"Reasons and revises","interface":{"inputs":[{"id":"in","type":"message"}],"outputs":[{"id":"out","type":"message"}]},"pipeline":{"pre":[],"post":[]},"model":"sonnet","harness":{"tier":"native","runner":"native","loop":"single_shot","instructions":"Solve the question step by step. If you are shown other agents' reasoning, weigh it by its confidence, look for mistakes in theirs and in yours, and give your own updated answer.\nEnd with one line: Final: <the answer alone>","max_steps":30,"own_memory":"keep","capabilities":{"context_con