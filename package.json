{
  "name": "mas-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc -b --noEmit",
    "test": "vitest run",
    "server": "TSX_TSCONFIG_PATH=tsconfig.server.json node --experimental-sqlite --no-warnings=ExperimentalWarning --import tsx/esm server/index.ts",
    "server:dev": "TSX_TSCONFIG_PATH=tsconfig.server.json node --experimental-sqlite --no-warnings=ExperimentalWarning --watch --import tsx/esm server/index.ts"
  },
